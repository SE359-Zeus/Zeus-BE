PORT=8082
BASE_URL=http://localhost:8082
SQLITE_DB=./sales.db
VALKEY_ADDR=localhost:6379
MRP_URL=http://localhost:8082
SCM_URL=http://localhost:8083
LOG_LEVEL=info
JWT_PUBLIC_KEY_PATH=jwt_public.pem
RABBITMQ_URL=amqp://hungdepzai:hungdepzai@100.70.122.82:5674/

# ── Observability ─────────────────────────────────────────────────────────────
#
# APP_ENV
#   Deployment environment label attached to every log stream and metric.
#   Used as the "env" label in Alloy / Grafana.
#   Values: development | staging | production
APP_ENV=development

# ALLOY_URL
#   Alloy Loki-receiver endpoint that this service pushes logs to.
#   The service sends JSON to this URL; Alloy relabels and forwards to
#   Grafana Cloud Loki.
#
#   Self-hosted Alloy (docker-compose):
#     ALLOY_URL=http://alloy:3100/loki/api/v1/push
#
#   Grafana Cloud direct push (bypass Alloy, use when Alloy is not deployed):
#     ALLOY_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
#
#   Leave empty to log to stdout only (local dev default).
ALLOY_URL=

# ALLOY_USERNAME
#   Only required when pushing directly to Grafana Cloud (not local Alloy).
#   Value: your Grafana Cloud "User" / numeric instance ID.
#   Find it at: grafana.com → your stack → Details → Loki → "User"
ALLOY_USERNAME=

# ALLOY_PASSWORD
#   Only required when pushing directly to Grafana Cloud (not local Alloy).
#   Value: a Grafana Cloud API token with "MetricsPublisher" or "Editor" scope.
#   Generate at: grafana.com → your org → API Keys → Add API Key
ALLOY_PASSWORD=